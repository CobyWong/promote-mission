{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.0",
    "expo": "~57.0.4",
    "expo-background-fetch": "^57.0.2",
    "expo-document-picker": "^57.0.0",
    "expo-file-system": "^57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-task-manager": "^57.0.2",
    "expo-updates": "~57.0.10",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "preflight": "node ../../scripts/mobile-release-preflight.mjs",
    "build:preview:ios": "npx eas build --platform ios --profile preview",
